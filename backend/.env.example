# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Admin API Key used by Discord Bot & Management CLI
# GENERATE A STRONG RANDOM KEY FOR PRODUCTION (e.g. openssl rand -hex 32)
ADMIN_API_KEY=pavo_admin_secret_key_prod_2026_super_secure

# Cryptographic HMAC Signing Secret for Client Response Tamper-Proofing
SIGNING_SECRET=pavo_client_hmac_signing_secret_998877665544332211

# SQLite Database File Path (Mounted as volume in Docker)
DB_PATH=/app/data/licenses.db

# Rate Limiting
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_ADMIN=500
