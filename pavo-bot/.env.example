# ==============================================
# Pavo Bot - Environment Variables
# ==============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to Git!

# Discord Bot Token (from Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Discord OAuth2 Configuration (from Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=YOUR_APPLICATION_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_APPLICATION_CLIENT_SECRET_HERE

# Public URL and Redirect URI for OAuth Verification Website
# Local development example: http://localhost:10000/oauth/callback
# Production example: https://your-bot-domain.onrender.com/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:10000/oauth/callback
PUBLIC_URL=http://localhost:10000

# Server Port (Defaults to 10000 on Render / cloud)
PORT=10000

# ==============================================
# Pavo License Backend API Connection
# ==============================================
LICENSE_API_URL=http://localhost:5000
LICENSE_API_KEY=pavo_secret_admin_key_change_me_in_production_2026

